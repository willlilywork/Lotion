{
  "name": "lotion",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first workspace with advanced databases",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check-ids",
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "e2e": "playwright test",
    "check-ids": "node scripts/check-ids.ts",
    "package": "pnpm build && electron-builder --publish never",
    "perf": "node scripts/perf.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "main": "out/main/main.cjs",
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "zod": "4.6.7"
  },
  "author": {
    "name": "Will Lily",
    "email": "353627199+willlilywork@users.noreply.github.com"
  },
  "homepage": "https://github.com/willlilywork/Lotion"
}
